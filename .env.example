# Chép thành .env rồi điền giá trị thật. Không commit .env.
# Dev: PostgreSQL 18 portable ở .local/ (bật/tắt: npm run db:start / db:stop), role webqlcd_app, port 5433.
DATABASE_URL=postgres://webqlcd_app:<mật-khẩu>@127.0.0.1:5433/webqlcd

# Better Auth: secret ngẫu nhiên ≥ 32 ký tự (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
BETTER_AUTH_SECRET=<secret>
BETTER_AUTH_URL=http://localhost:3000
