# Biến cho docker-compose.yml (production). Chép thành deploy/.env trên VPS, không commit.
# Mật khẩu DB nằm trong URL: dùng hex để khỏi phải mã hoá ký tự (openssl rand -hex 24).
# Secret và khoá: openssl rand -base64 32. Cất bản sao mọi giá trị dưới đây NGOÀI VPS (runbook mục 2).
DOMAIN=<tên miền, ví dụ app.tp83.vn>

POSTGRES_PASSWORD=<hex>
OWNER_DB_PASSWORD=<hex>
APP_DB_PASSWORD=<hex>

BETTER_AUTH_SECRET=<base64>
CCCD_ENCRYPTION_KEY=<base64 32 byte>
CCCD_HMAC_KEY=<base64 32 byte>

# Public key gpg nhận bản sao lưu (private key cất ngoài VPS).
BACKUP_PUBLIC_KEY_FILE=./deploy/backup-public.asc
BACKUP_AT=02:00
BACKUP_KEEP=30
# Tuỳ chọn: file chạy được trong container backup, nhận đường dẫn bản vừa tạo, chép ra ngoài VPS.
BACKUP_POST_HOOK=
